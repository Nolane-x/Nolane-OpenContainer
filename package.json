{
  "name": "nolane-opencontainer",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Open, self-hostable browser-native Node/web development runtime.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "ci": "npm run check && npm run product:scope:verify && npm run docs:verify && npm test && npm run compat:corpus:verify && npm run compat:promotion && npm run distribution:certify && npm run release:evidence && npm run release:verify && npm run critical:contract-flake && npm run release:preflight && npm run release:governance && npm run evidence:assure:contract",
    "playground": "node apps/playground/server.mjs",
    "browser:acceptance": "node scripts/browser-acceptance.mjs",
    "hosting:self-check": "node scripts/hosting-self-check.mjs",
    "compat:corpus:verify": "node scripts/compat-corpus.mjs --verify-online",
    "compat:promotion": "node scripts/evaluate-promotion.mjs",
    "distribution:build": "node scripts/build-distribution.mjs",
    "distribution:certify": "node scripts/certify-distribution.mjs",
    "distribution:browser": "node scripts/certify-distribution-browser.mjs",
    "release:evidence": "node scripts/build-release-evidence.mjs",
    "release:verify": "node scripts/verify-release-evidence.mjs",
    "release:preflight": "node scripts/evaluate-release-preflight.mjs",
    "release:governance": "node scripts/verify-release-governance.mjs",
    "critical:contract-flake": "node scripts/run-critical-flake-campaign.mjs",
    "critical:browser-flake": "node scripts/run-browser-flake-campaign.mjs",
    "docs:verify": "node scripts/generate-developer-docs.mjs",
    "diagnostics:local": "node scripts/opencontainer-diagnostic.mjs --simulate-error OC_INVALID_STATE",
    "product:scope:verify": "node scripts/verify-product-scope.mjs",
    "browser:profile:verify": "node scripts/verify-browser-profile.mjs",
    "evidence:assure:contract": "node scripts/build-evidence-assurance.mjs && node scripts/verify-evidence-assurance.mjs contract",
    "evidence:assure:browser": "node scripts/capture-browser-evidence-assurance.mjs && node scripts/verify-evidence-assurance.mjs browser"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/wasm-runtime": "1.2.4",
    "lightningcss": "npm:lightningcss-wasm@1.33.0",
    "rolldown": "1.2.9",
    "vite": "8.3.0"
  }
}
