{
  "name": "nolane-opencontainer",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Open, self-hostable browser-native Node/web development runtime.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "ci": "npm run check && npm run product:scope:verify && npm run docs:verify && npm test && npm run security:dependencies && npm run security:regressions && npm run security:review && npm run operations:drill && npm run compat:corpus:verify && npm run compat:promotion && npm run compat:matrix && npm run compat:release-report && npm run distribution:certify && npm run release:evidence && npm run release:verify && npm run security:supply-chain && npm run resource:retention:audit && npm run critical:contract-flake && npm run release:preflight && npm run release:governance && npm run evidence:assure:contract",
    "playground": "node apps/playground/server.mjs",
    "browser:acceptance": "node scripts/browser-acceptance.mjs",
    "hosting:self-check": "node scripts/hosting-self-check.mjs",
    "compat:corpus:verify": "node scripts/compat-corpus.mjs --verify-online",
    "compat:promotion": "node scripts/evaluate-promotion.mjs",
    "distribution:build": "node scripts/build-distribution.mjs",
    "distribution:certify": "node scripts/certify-distribution.mjs",
    "distribution:browser": "node scripts/certify-distribution-browser.mjs",
    "release:evidence": "node scripts/build-release-evidence.mjs",
    "release:verify": "node scripts/verify-release-evidence.mjs",
    "release:preflight": "node scripts/evaluate-release-preflight.mjs",
    "release:governance": "node scripts/verify-release-governance.mjs",
    "critical:contract-flake": "node scripts/run-critical-flake-campaign.mjs",
    "critical:browser-flake": "node scripts/run-browser-flake-campaign.mjs",
    "docs:verify": "node scripts/generate-developer-docs.mjs",
    "diagnostics:local": "node scripts/opencontainer-diagnostic.mjs --simulate-error OC_INVALID_STATE",
    "product:scope:verify": "node scripts/verify-product-scope.mjs",
    "browser:profile:verify": "node scripts/verify-browser-profile.mjs",
    "evidence:assure:contract": "node scripts/build-evidence-assurance.mjs && node scripts/verify-evidence-assurance.mjs contract",
    "evidence:assure:browser": "node scripts/capture-browser-evidence-assurance.mjs && node scripts/verify-evidence-assurance.mjs browser",
    "security:dependencies": "node scripts/security-dependency-audit.mjs",
    "security:review": "node scripts/run-security-review.mjs",
    "security:regressions": "node scripts/run-security-regressions.mjs",
    "operations:drill": "node scripts/run-operations-drills.mjs",
    "compat:release-report": "node scripts/release-compatibility-report.mjs",
    "compat:matrix": "node scripts/release-compatibility-matrix.mjs",
    "security:supply-chain": "node scripts/run-supply-chain-review.mjs",
    "resource:evidence": "node scripts/capture-resource-evidence.mjs",
    "resource:retention:audit": "node scripts/audit-resource-retention.mjs",
    "p3:evidence:browser": "node scripts/capture-p3-wave2-browser-evidence.mjs",
    "p3:corruption:evidence": "node scripts/capture-p3-corruption-browser-evidence.mjs",
    "p3:low-storage:evidence": "node scripts/capture-p3-low-storage-browser-evidence.mjs",
    "p3:safe-restore:evidence": "node scripts/capture-p3-safe-restore-browser-evidence.mjs",
    "p3:destructive-lifecycle:evidence": "node scripts/capture-p3-destructive-lifecycle-browser-evidence.mjs",
    "p3:external-source:evidence": "node scripts/capture-p3-external-source-browser-evidence.mjs",
    "p3:freeze-writer:evidence": "node scripts/p3-freeze-writer-failover.mjs",
    "p3:durability:evidence": "node scripts/capture-p3-durability-boundary-browser-evidence.mjs",
    "p3:native-external:evidence": "node scripts/p3-native-external-permission.mjs",
    "p4:publication-atomicity:evidence": "node scripts/p4-publication-atomicity.mjs",
    "p4:artifact-boundary:evidence": "node scripts/capture-p4-artifact-boundary-browser-evidence.mjs",
    "p4:ecosystem-layout:evidence": "node scripts/p4-ecosystem-layout.mjs",
    "p4:command-diagnostics:evidence": "node scripts/p4-command-diagnostics.mjs",
    "p4:final-package:evidence": "node scripts/p4-final-package.mjs",
    "p6:toolchain-vite:evidence": "node scripts/capture-p6-toolchain-browser-evidence.mjs",
    "p2:runtime:evidence": "node scripts/p2-runtime-evidence.mjs",
    "p1:browser-substrate:evidence": "node scripts/p1-browser-substrate.mjs",
    "p10:ai-consumer:evidence": "node scripts/p10-ai-consumer-evidence.mjs",
    "p6:vitest:evidence": "node scripts/p6-vitest-real-execution.mjs",
    "p9:ui:evidence": "node scripts/p9-ui-rendered.mjs",
    "p7:declared-profile:evidence": "node scripts/p7-declared-profile.mjs",
    "p7:storage:evidence": "node scripts/p7-storage-amplification.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/wasm-runtime": "1.2.4",
    "lightningcss": "npm:lightningcss-wasm@1.33.0",
    "rolldown": "1.2.9",
    "vite": "8.3.0"
  }
}
