    },
    {
      "id": "P2-07",
      "requirement": "Freeze allowed synchronous RPC call graph and prove forbidden reentrancy cannot deadlock module loading."
    },
    {
      "id": "P2-08",
      "requirement": "Test parent/child teardown and orphan policy for bounded process-tree semantics."
    },
    {
      "id": "P2-09",
      "requirement": "Prove virtual-port allocation/release cannot leak or route to a stale process after PID reuse."
    },
    {
      "id": "P2-10",
      "requirement": "Test stdout/stderr floods with backpressure and bounded UI retention."
    },
    {
      "id": "P2-11",
      "requirement": "Prove resource handles are epoch-bound and stale handles fail closed after authority restart."
    },
    {
      "id": "P2-12",
      "requirement": "Test large transferable streams and abort races under actual Chromium memory pressure."
    },
    {
      "id": "P2-13",
      "requirement": "Run repeated boot/teardown and spawn/kill cycles long enough to detect retained worker/port state."
    },
    {
      "id": "P2-14",
      "requirement": "Expose structured stable errors instead of leaking internal worker topology to consumers."
    }
