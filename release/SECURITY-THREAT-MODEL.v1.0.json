{
  "schema": "opencontainer.security-threat-model.v1.0",
  "frozenAt": "2026-09-27",
  "profile": "desktop-chrome153-ubuntu2404-x64-ci",
  "assumptions": [
    "Guest/application JavaScript may be hostile relative to the trusted host page.",
    "Package bytes and metadata are untrusted until integrity, archive and identity checks succeed.",
    "Browser origin storage is trusted only through OpenContainer authorities; guest code receives no origin-wide storage authority.",
    "Anything delivered to browser JavaScript is observable by the local user; long-lived provider credentials must not be treated as secret from that user.",
    "Future AI/provider integrations are outside Core and must enter through separately versioned capability adapters."
  ],
  "trustZones": [
    {
      "id": "trusted-host",
      "name": "Trusted host/page authority",
      "trust": "trusted",
      "assets": [
        "runtime authorities",
        "capability policy",
        "support/evidence"
      ],
      "entryPoints": [
        "SDK",
        "browser bridge"
      ]
    },
    {
      "id": "guest-js",
      "name": "Guest JavaScript/Workers",
      "trust": "untrusted",
      "assets": [
        "guest code",
        "guest messages"
      ],
      "entryPoints": [
        "ESM publication",
        "worker RPC",
        "sync RPC"
      ]
    },
    {
      "id": "package-bytes",
      "name": "Package bytes/metadata",
      "trust": "untrusted",
      "assets": [
        "tarballs",
        "package.json",
        "lockfile graph"
      ],
      "entryPoints": [
        "registry fetch",
        "frozen installer",
        "resolver"
      ]
    },
    {
      "id": "preview",
      "name": "Virtual preview/service-worker edge",
      "trust": "untrusted-content boundary",
      "assets": [
        "preview HTTP content",
        "route proofs"
      ],
      "entryPoints": [
        "Service Worker fetch",
        "preview handler"
      ]
    },
    {
      "id": "storage",
      "name": "Workspace/package persistence",
      "trust": "canonical-data boundary",
      "assets": [
        "VFS",
        "OPFS checkpoints",
        "snapshots",
        "imports"
      ],
      "entryPoints": [
        "transactions",
        "restore/import",
        "multi-tab writers"
      ]
    },
    {
      "id": "future-ai-credentials",
      "name": "Future AI/provider credentials",
      "trust": "out-of-Core privileged",
      "assets": [
        "tokens",
        "provider requests"
      ],
      "entryPoints": [
        "future adapters only"
      ]
    }
  ],
  "threats": [
    {
      "id": "TM-01",
      "zones": [
        "guest-js",
        "trusted-host"
      ],
      "threat": "Guest escapes Worker/capability boundary or invokes undeclared host authority.",
      "severity": "CRITICAL",
      "controls": [
        "Dedicated Worker execution",
        "explicit host RPC methods",
        "ResourceGovernor worker leases",
        "browser strict Worker CSP"
      ],
      "evidence": [
        "tests/browser-guest-worker.test.js",
        "tests/worker-authority.test.js",
        "tests/browser-node-compat.test.js"
      ]
    },
    {
      "id": "TM-02",
      "zones": [
        "package-bytes",
        "storage"
      ],
      "threat": "Archive traversal, link abuse, duplicate paths, decompression growth or lifecycle scripts mutate trusted state.",
      "severity": "CRITICAL",
      "controls": [
        "SRI",
        "bounded streaming decompression",
        "TAR type/path/duplicate checks",
        "transactional publication",
        "lifecycle scripts deny-by-default"
      ],
      "evidence": [
        "tests/artifact-authority.test.js",
        "tests/frozen-install.test.js",
        "tests/security-hardening.test.js",
        "tests/security-malicious-package.test.js"
      ]
    },
    {
      "id": "TM-03",
      "zones": [
        "package-bytes",
        "trusted-host"
      ],
      "threat": "Malicious lockfile/exports/imports graph causes capability escape or resource exhaustion.",
      "severity": "HIGH",
      "controls": [
        "lockfile byte/node budgets",
        "resolver package-root checks",
        "native addon deny",
        "frozen integrity"
      ],
      "evidence": [
        "tests/resolver.test.js",
        "tests/security-fuzz.test.js",
        "tests/security-hardening.test.js"
      ]
    },
    {
      "id": "TM-04",
      "zones": [
        "preview",
        "trusted-host"
      ],
      "threat": "Preview content inherits host credentials, stale route authority, unsafe navigation or host storage access.",
      "severity": "CRITICAL",
      "controls": [
        "credential stripping",
        "owner+epoch+workspace+session+version route proof",
        "sandboxed hostile frame court",
        "no-store edge"
      ],
      "evidence": [
