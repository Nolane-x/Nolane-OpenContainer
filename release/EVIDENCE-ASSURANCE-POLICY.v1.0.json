  "criticalClaimPolicy": {
    "minimumClosureLevel": "INTEGRATION",
    "localClaimsMustBeReproducedBeforeRelease": true,
    "sourceOrDocumentationCannotCloseCriticalGate": true,
    "blockedHarnessCannotPass": true
