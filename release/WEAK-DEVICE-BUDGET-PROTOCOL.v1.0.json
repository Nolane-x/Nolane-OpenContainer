      "aiModeSwitchP95Ms": 2,
      "saveCanonicalP95Ms": 20,
      "processRunP95Ms": 20,
      "cycleP95Ms": 25
    },
    "heapSlope": "ceil(max(8 MiB/hour, max(0,max_calibration_slope)*1.5 + 2 MiB/hour))",
    "heapPeak": "ceil(max_calibration_peak*1.25 + 16 MiB)"
  },
  "validation": {
    "memoryClassesGiB": [
      4,
      8
    ],
    "minimumReceiptsPerClass": 1,
    "phase": "validation",
    "devicesMustBeDisjointFromCalibration": true,
    "productSourceFingerprintMustMatch": true,
    "uiSoakMinimumMinutes": 480,
    "uiSoakPhase": "soak-ui",
    "measurementProtocolFingerprintMustMatch": true
  },
  "promotion": {
